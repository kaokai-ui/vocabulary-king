{
  "name": "vocabulary-king",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:vocab": "node scripts/export-game-vocabulary.mjs",
    "export:ios-locales": "node scripts/export-ios-locales.mjs",
    "ensure:vocab-uids": "node scripts/ensure-vocabulary-uids.mjs",
    "manage:vocab-uid-aliases": "node scripts/manage-vocabulary-uid-aliases.mjs",
    "apply:vocab-rebuild": "node scripts/apply-vocabulary-rebuild.mjs",
    "migrate:vocab-senses": "node scripts/migrate-vocabulary-senses.mjs",
    "fill:vocab-ipa": "node scripts/fill-vocabulary-ipa.mjs",
    "build:ielts-source": "node scripts/build-ielts-source.mjs",
    "convert:vocab:source": "node scripts/convert-vocabulary-sources.mjs",
    "refresh:vocab": "node scripts/export-game-vocabulary.mjs",
    "writeback:vocab": "node scripts/apply-vocabulary-decisions-to-source.mjs",
    "check:content": "node scripts/check-vocabulary-content.mjs",
    "verify:vocab": "node scripts/verify-vocabulary-data.mjs",
    "dev": "vite",
    "predev": "npm run build:vocab",
    "build": "vite build",
    "build:site": "vite build",
    "check:site": "npm run test && npm run verify:vocab && npm run build:site",
    "prebuild": "npm run build:vocab",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "opencc-js": "^1.3.2",
    "playwright": "^1.60.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
